using annovar for annotation of variants
input = avinput
variant information required
    col = "chromosome", "start", "end" , "ref","alt"


Stepwise data processing for annotation and annotation using ANNOVAR
1. Collect rsID from eQTL Results
    1.1 remove duplicates 
2. fetch complete ID from VCF files 
        # Read the rsID from a eQTL result file into a character vector
        rsID <- scan("/home/sumit2/MMNP_RNAseqdata/MMNP_eQTL/Matrix_eQTL_Analysis/01_Raw_Data/Genotype_Data/cis_SNPs_info09_171_cis_SNP.txt", what = "character", sep = "\n")

        # Read the SNP all data (extract from VCF or VCF file directly) file where you want to search for keywords
        file_path <- "/home/sumit2/MMNP_RNAseqdata/MMNP_eQTL/Matrix_eQTL_Analysis/01_Raw_Data/Genotype_Data/SNP_All_data_Chr_ALL_MMNP_MCduo_info09_b37_171_23042018_trans.txt"

        # Read the lines of the file into a character vector
        file_lines <- readLines(file_path)

        # Find lines containing any of the keywords
        matching_lines <- grep(paste(keywords, collapse = "|"), file_lines, value = TRUE)

        # Print the matching lines
        print(matching_lines)

3. Look up and confirm the IDs extracted from VCF
4. Subset VCF using vcftools
    $PATH1 = /home/sumit2/MMNP_RNAseqdata/Imputed_Genome
    $PATH2 = /home/sumit2/MMNP_RNAseqdata/MMNP_eQTL/Matrix_eQTL_Analysis/01_Raw_Data/Genotype_Data
    vcftools --vcf $PATH/Chr_ALL_MMNP_MCduo_info05_b37_171_QC_EDITED_filtered_data.vcf --out $PATH/ciseQTL_MMNP_MCduo_info09_b37_171_QC  --recode  --snps $PATH/snpid_for_subset_vcf_ANNOVAr.txt
5. Convert VCF to avinput
    perl convert2annovar.pl -format vcf4old ../../01_Raw_Data/Genotype_Data/ciseQTL_MMNP_MCduo_info09_b37_171_QC.recode.vcf  > ciseQTL_MMNP_MCduo_info09_b37_171_QC.avinput

6. perl table_annovar.pl ciseQTL_MMNP_MCduo_info09_b37_171_QC.avinput humandb/ -buildver hg19 -out cis_SNP_DATA_info09_b37_171_23042018_trans.csv -remove -protocol refGeneWithVer,cytoBand -operation g,r -nastring . -csvout -polish


